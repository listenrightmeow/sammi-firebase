# Added at build (D20): a behavior the code needs that no scenario stated.
scenario "on a machine that has never connected, generates a device id and stores it before the session":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
  when: Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  predict success:
    response OK CommandResponse { answer: "ok", status: { state: "Connected", deviceId: matching "^[a-z0-9]{8}$" } }
    ini has ordered [
      IniWrite with IniWrite { section: "connection", key: "device_id", value: matching "^[a-z0-9]{8}$" },
      IniWrite with IniWrite { section: "connection", key: "session", value: any string },
      IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" },
      IniWrite with IniWrite { section: "index", key: "collections", json: [] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { } },
      IniWrite with IniWrite { section: "index", key: "last_sync", value: "1793275200000" }
    ]
    firebase has ordered [
      update with CloudUpdate { path: matching "^users/uid-streamer/meta/devices/[a-z0-9]{8}$", fields: { name: any string, lastSeen: 1793275200000 } }
    ]
    sammi has ordered [
      Trigger with Trigger { name: "Firebase: Connected", pullData: { eventId: any uuid, timestamp: any timestamp, version: 1, eventType: "Connected", source: "local", deviceId: @ini[0].value, email: "streamer@example.com", projectId: "sammi-probe", documents: 0 } },
      Trigger with Trigger { name: "Firebase: Mirror Reconciled", pullData: { eventId: any uuid, timestamp: any timestamp, version: 1, eventType: "MirrorReconciled", source: "local", deviceId: @ini[0].value, pushed: 0, applied: 0, dropped: 0, cause: "connect" } }
    ]

