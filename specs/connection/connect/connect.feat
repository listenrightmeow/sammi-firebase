  when: Connect { config: { apiKey: "short", authDomain: "example.com", projectId: "x", appId: "nope", databaseURL: "http://localhost" }, email: "streamer@example.com", password: "correct-horse-battery" }
  predict rejection INVALID_CONFIG:
    response ERR CommandError { code: "INVALID_CONFIG", answer: "error: invalid config" }
    ini has []
    firebase has []
    sammi has []

scenario "rejects ALREADY_CONNECTED on a second Connect":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  predict rejection ALREADY_CONNECTED:
    response ERR CommandError { code: "ALREADY_CONNECTED", answer: "error: already connected" }
    ini has []
    firebase has []
    sammi has []

scenario "a wrong password is refused: ConnectionFailed fires and nothing is written":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
  when: Connect { email: "streamer@example.com", password: "wrong" }
  predict error CREDENTIALS_INVALID:
    response ERR CommandError { code: "CREDENTIALS_INVALID", answer: "error: credentials invalid" }
    ini has []
    firebase has []
    sammi has ordered [
      Trigger with Trigger { name: "Firebase: Connection Failed", pullData: { eventId: any uuid, eventType: "ConnectionFailed", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", reason: "credentials invalid" } }
    ]

scenario "an API key the project does not recognise is refused: ConnectionFailed names the setup step":
