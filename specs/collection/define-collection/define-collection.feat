feat 1.0

# SPEC-COL-001 — Define Collection
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-COL-001 "Define Collection"
context SammiFirebase
aggregate Collection
type command
status agreed

construct:
  handler at src/features/define-collection/handler.ts
  touches src/features/define-collection/**
  Validate the name and field names against [a-z][a-z0-9_]{0,31}; names starting with _ are reserved (SF-ADR-008).
  Write the declaration to firebase.ini [schema] and to users/{uid}/meta/schema/<name> with the server timestamp (H1); fire CollectionDefined with source local.
  Defaults: strict false, two-way true. Fields arrive as a comma-separated box; trim and ignore empty entries.

enforce:
  validate every name; name the first bad one in the answer
  write [schema] and meta/schema in the same command
  fire CollectionDefined with the fields, strict and twoWay
  rejects BAD_COLLECTION_NAME when the collection name or a field name is not [a-z][a-z0-9_]{0,31} or starts with _
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name or a field name is not [a-z][a-z0-9_]{0,31} or starts with _
  rejects NOT_CONNECTED when no connection is established

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record CloudSet
  record CloudNode
  record AuthUser
  record Trigger

scenario "declares a strict two-way collection locally and in the cloud":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "hue", fields: "ip, scene_1", strict: true, twoWay: true }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniWrite with IniWrite { section: "schema", key: "hue", json: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275200000 } }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275200000 } }
    ]
    sammi has ordered [
      Trigger with Trigger { name: "Firebase: Collection Defined", pullData: { eventId: any uuid, eventType: "CollectionDefined", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "hue", fields: matching "scene_1", strict: true, twoWay: true } }
    ]

scenario "defaults to open and two-way when the flags are omitted":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "viewers", fields: "name,points,tier" }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniWrite with IniWrite { section: "schema", key: "viewers", json: { fields: ["name", "points", "tier"], strict: false, two_way: true, _t: 1793275200000 } }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/meta/schema/viewers", value: { fields: ["name", "points", "tier"], strict: false, two_way: true, _t: 1793275200000 } }
    ]
    sammi has ordered [
      Trigger with Trigger { name: "Firebase: Collection Defined", pullData: { eventId: any uuid, eventType: "CollectionDefined", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "viewers", strict: false, twoWay: true } }
    ]

scenario "redeclaring a collection replaces its declaration":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip"], strict: true, two_way: true, _t: 1793275100000 } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "hue", fields: "ip, scene_1", strict: false }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniWrite with IniWrite { section: "schema", key: "hue", json: { fields: ["ip", "scene_1"], strict: false, two_way: true, _t: 1793275200000 } }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: false, two_way: true, _t: 1793275200000 } }
    ]
    sammi has ordered [
      Trigger with Trigger { name: "Firebase: Collection Defined", pullData: { eventId: any uuid, eventType: "CollectionDefined", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "hue", strict: false, twoWay: true } }
    ]

scenario "rejects BAD_COLLECTION_NAME for a capitalised name":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "Hue", fields: "ip" }
  predict rejection BAD_COLLECTION_NAME:
    response ERR CommandError { code: "BAD_COLLECTION_NAME", answer: "error: bad collection name Hue" }
    ini has []
    firebase has []
    sammi has []

scenario "rejects BAD_COLLECTION_NAME for a reserved field":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "hue", fields: "ip, _t" }
  predict rejection BAD_COLLECTION_NAME:
    response ERR CommandError { code: "BAD_COLLECTION_NAME", answer: "error: bad collection name _t" }
    ini has []
    firebase has []
    sammi has []

scenario "rejects BAD_COLLECTION_NAME for a name over 32 characters":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", fields: "ip" }
  predict rejection BAD_COLLECTION_NAME:
    response ERR CommandError { code: "BAD_COLLECTION_NAME", answer: "error: bad collection name aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
    ini has []
    firebase has []
    sammi has []

scenario "rejects NOT_CONNECTED when nothing is connected":
  given:
    clock at "2026-10-29T12:00:00Z"
  when: DefineCollection { name: "hue", fields: "ip" }
  predict rejection NOT_CONNECTED:
    response ERR CommandError { code: "NOT_CONNECTED", answer: "error: not connected" }
    ini has []
    firebase has []
    sammi has []

# Added at build (D20): a behavior the code needs that no scenario stated.
scenario "a collection may be declared with no fields":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DefineCollection { name: "log" }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniWrite with IniWrite { section: "schema", key: "log", json: { fields: [], strict: false, two_way: true, _t: 1793275200000 } }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/meta/schema/log", value: { fields: [], strict: false, two_way: true, _t: 1793275200000 } }
    ]
    sammi has ordered [
      Trigger with Trigger { name: "Firebase: Collection Defined", pullData: { eventId: any uuid, timestamp: any timestamp, version: 1, eventType: "CollectionDefined", source: "local", deviceId: "dev1", collection: "log", fields: "[]", strict: false, twoWay: true } }
    ]
