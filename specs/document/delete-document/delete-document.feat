feat 1.0

# SPEC-DOC-007 — Delete Document
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-DOC-007 "Delete Document"
context SammiFirebase
aggregate Document
type command
status agreed

construct:
  handler at src/features/delete-document/handler.ts
  touches src/features/delete-document/**
  Remove the document from the mirror, the index, the variable and the cloud. Mirror rule 1 order with a remove() in the cloud; rule 5: the pending entry is a tombstone so an offline delete still lands.

enforce:
  delete the ini key, drop the id from [index], drop the hash, rewrite fb_<c> without the id
  answer ok and fire DocumentDeleted with the previous document
  a rejection writes nothing, publishes nothing and fires nothing
  rejects MISSING when the document is not in the mirror
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name is not [a-z][a-z0-9_]{0,31}
  rejects BAD_ID when the id is not [A-Za-z0-9_-]{1,64}

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record IniDelete
  record CloudRemove
  record CloudNode
  record AuthUser
  record SetVariable
  record Trigger

scenario "deletes a document and leaves its siblings":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/viewers/12345678", value: { name: "alice", points: 10, _t: 1793275150000, _d: "dev2" } }, node with CloudNode { path: "users/uid-streamer/collections/viewers/222", value: { name: "bob", points: 3, _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DeleteDocument { collection: "viewers", id: "12345678" }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniDelete with IniDelete { section: "collection:viewers", key: "12345678" },
      IniWrite with IniWrite { section: "index", key: "viewers", json: ["222"] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "viewers/222": any string } },
      IniWrite with IniWrite { section: "pending", key: "viewers/12345678", json: { op: "delete", at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "viewers/12345678" }
    ]
    firebase has ordered [
      remove with CloudRemove { path: "users/uid-streamer/collections/viewers/12345678" }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { "222": { name: "bob", points: 3 } } },
      Trigger with Trigger { name: "Firebase: Document Deleted", pullData: { eventId: any uuid, eventType: "DocumentDeleted", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "viewers", id: "12345678", previous: "{\"name\": \"alice\", \"points\": 10}", causationId: any string } }
    ]

scenario "deleting the last document leaves an empty collection variable":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/counters/deaths", value: { value: 7, _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DeleteDocument { collection: "counters", id: "deaths" }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniDelete with IniDelete { section: "collection:counters", key: "deaths" },
      IniWrite with IniWrite { section: "index", key: "counters", json: [] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { } },
      IniWrite with IniWrite { section: "pending", key: "counters/deaths", json: { op: "delete", at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "counters/deaths" }
    ]
    firebase has ordered [
      remove with CloudRemove { path: "users/uid-streamer/collections/counters/deaths" }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_counters", value: { } },
      Trigger with Trigger { name: "Firebase: Document Deleted", pullData: { eventId: any uuid, eventType: "DocumentDeleted", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "counters", id: "deaths", previous: "{\"value\": 7}", causationId: any string } }
    ]

scenario "rejects MISSING when the document does not exist":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DeleteDocument { collection: "viewers", id: "12345678" }
  predict rejection MISSING:
    response ERR CommandError { code: "MISSING", answer: "error: missing viewers/12345678" }
    ini has []
    firebase has []
    sammi has []

