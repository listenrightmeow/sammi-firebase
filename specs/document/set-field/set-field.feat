feat 1.0

# SPEC-DOC-004 — Set Field
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-DOC-004 "Set Field"
context SammiFirebase
aggregate Document
type command
status agreed

construct:
  handler at src/features/set-field/handler.ts
  touches src/features/set-field/**
  Set one field without JSON: a number-looking box value is stored as a number, anything else as a string; a `str:` prefix forces a string.
  Creates the document when missing (so a counter deck needs no startup button). Mirror rule 1 order; the cloud write is update() of the one field. Answers with the value stored.

enforce:
  store numeric text as a number and other text as a string
  create the document when missing and fire DocumentCreated, otherwise DocumentUpdated
  answer with the stored value
  a rejection writes nothing, publishes nothing and fires nothing
  rejects BAD_FIELD when the field name is not [a-z][a-z0-9_]{0,31} or is reserved
  rejects UNKNOWN_FIELD when the collection is strict and the field is not declared
  rejects TOO_LARGE when the value exceeds 4 KB or the document would exceed 8 KB
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name is not [a-z][a-z0-9_]{0,31}
  rejects BAD_ID when the id is not [A-Za-z0-9_-]{1,64}

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record IniDelete
  record CloudSet
  record CloudUpdate
  record CloudNode
  record AuthUser
  record SetVariable
  record Trigger

scenario "sets a string field on an existing document":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275100000 } }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: SetField { collection: "hue", id: "settings", field: "ip", value: "10.0.0.9" }
  predict success:
    response OK CommandResponse { answer: "10.0.0.9", value: "10.0.0.9" }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:hue", key: "settings", json: { ip: "10.0.0.9", scene_1: "3f2c", _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "hue/settings": any string } },
      IniWrite with IniWrite { section: "pending", key: "hue/settings", json: { op: "set_field", field: "ip", value: "10.0.0.9", at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "hue/settings" }
    ]
    firebase has ordered [
      update with CloudUpdate { path: "users/uid-streamer/collections/hue/settings", fields: { ip: "10.0.0.9", _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_hue", value: { settings: { ip: "10.0.0.9", scene_1: "3f2c" } } },
      Trigger with Trigger { name: "Firebase: Document Updated", pullData: { eventId: any uuid, eventType: "DocumentUpdated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "hue", id: "settings", changed: "{\"ip\": \"10.0.0.9\"}", causationId: any string } }
    ]

scenario "numeric text is stored as a number and the document is created when missing":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: SetField { collection: "counters", id: "deaths", field: "value", value: "7" }
  predict success:
    response OK CommandResponse { answer: "7", value: 7 }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:counters", key: "deaths", json: { value: 7, _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "collections", json: ["counters"] },
      IniWrite with IniWrite { section: "index", key: "counters", json: ["deaths"] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "counters/deaths": any string } },
      IniWrite with IniWrite { section: "pending", key: "counters/deaths", json: { op: "set_field", field: "value", value: 7, at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "counters/deaths" }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/collections/counters/deaths", value: { value: 7, _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_counters", value: { deaths: { value: 7 } } },
      Trigger with Trigger { name: "Firebase: Document Created", pullData: { eventId: any uuid, eventType: "DocumentCreated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "counters", id: "deaths", fields: "{\"value\": 7}", causationId: any string } }
    ]

scenario "the str: prefix keeps a numeric-looking value as a string":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/viewers/12345678", value: { name: "alice", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: SetField { collection: "viewers", id: "12345678", field: "pin", value: "str:0042" }
  predict success:
    response OK CommandResponse { answer: "0042", value: "0042" }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:viewers", key: "12345678", json: { name: "alice", pin: "0042", _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "viewers/12345678": any string } },
      IniWrite with IniWrite { section: "pending", key: "viewers/12345678", json: { op: "set_field", field: "pin", value: "0042", at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "viewers/12345678" }
    ]
    firebase has ordered [
      update with CloudUpdate { path: "users/uid-streamer/collections/viewers/12345678", fields: { pin: "0042", _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { "12345678": { name: "alice", pin: "0042" } } },
      Trigger with Trigger { name: "Firebase: Document Updated", pullData: { eventId: any uuid, eventType: "DocumentUpdated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "viewers", id: "12345678", changed: "{\"pin\": \"0042\"}", causationId: any string } }
    ]

scenario "rejects UNKNOWN_FIELD on a strict collection":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275100000 } }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: SetField { collection: "hue", id: "settings", field: "colour", value: "red" }
  predict rejection UNKNOWN_FIELD:
    response ERR CommandError { code: "UNKNOWN_FIELD", answer: "error: unknown field colour" }
    ini has []
    firebase has []
    sammi has []

