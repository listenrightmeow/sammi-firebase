    ]

scenario "a missing document starts from 0 and is created":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: IncrementField { collection: "viewers", id: "99", field: "points", by: 1 }
  predict success:
    response OK CommandResponse { answer: "1", value: 1 }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:viewers", key: "99", json: { points: 1, _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "collections", json: ["viewers"] },
      IniWrite with IniWrite { section: "index", key: "viewers", json: ["99"] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "viewers/99": any string } },
      IniWrite with IniWrite { section: "pending", key: "viewers/99", json: { op: "increment", field: "points", by: 1, at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "viewers/99" }
    ]
    firebase has ordered [
      increment with CloudIncrement { path: "users/uid-streamer/collections/viewers/99", field: "points", by: 1 },
      update with CloudUpdate { path: "users/uid-streamer/collections/viewers/99", fields: { _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { "99": { points: 1 } } },
      Trigger with Trigger { name: "Firebase: Document Created", pullData: { eventId: any uuid, eventType: "DocumentCreated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "viewers", id: "99", fields: "{\"points\":1}", causationId: any string } }
    ]

