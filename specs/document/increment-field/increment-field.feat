feat 1.0

# SPEC-DOC-005 — Increment Field
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-DOC-005 "Increment Field"
context SammiFirebase
aggregate Document
type command
status agreed

construct:
  handler at src/features/increment-field/handler.ts
  touches src/features/increment-field/**
  Add `by` (default 1, may be negative or fractional) to a numeric field; a missing document or field starts from 0 so a cheer button needs no setup.
  Mirror rule 1 order; the cloud write is a server-side increment so concurrent increments from two machines both count (rule 4). Answers with the new value: the write is the read (SF-ADR-005 §3).

enforce:
  start from 0 when the document or field is missing
  answer with the new total
  send a server-side increment, never the computed total
  a rejection writes nothing, publishes nothing and fires nothing
  rejects NOT_A_NUMBER when the existing field holds a string or `by` is not a number
  rejects BAD_FIELD when the field name is not [a-z][a-z0-9_]{0,31} or is reserved
  rejects UNKNOWN_FIELD when the collection is strict and the field is not declared
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name is not [a-z][a-z0-9_]{0,31}
  rejects BAD_ID when the id is not [A-Za-z0-9_-]{1,64}

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record IniDelete
  record CloudUpdate
  record CloudIncrement
  record CloudNode
  record AuthUser
  record SetVariable
  record Trigger

scenario "increments a viewer's points and answers with the new total (O8)":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/viewers", value: { fields: ["name", "points", "tier"], strict: false, two_way: true, _t: 1793275100000 } }, node with CloudNode { path: "users/uid-streamer/collections/viewers/12345678", value: { name: "alice", points: 10, _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: IncrementField { collection: "viewers", id: "12345678", field: "points", by: 5 }
  predict success:
    response OK CommandResponse { answer: "15", value: 15 }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:viewers", key: "12345678", json: { name: "alice", points: 15, _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "viewers/12345678": any string } },
      IniWrite with IniWrite { section: "pending", key: "viewers/12345678", json: { op: "increment", field: "points", by: 5, at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "viewers/12345678" }
    ]
    firebase has ordered [
      increment with CloudIncrement { path: "users/uid-streamer/collections/viewers/12345678", field: "points", by: 5 },
      update with CloudUpdate { path: "users/uid-streamer/collections/viewers/12345678", fields: { _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { "12345678": { name: "alice", points: 15 } } },
      Trigger with Trigger { name: "Firebase: Document Updated", pullData: { eventId: any uuid, eventType: "DocumentUpdated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "viewers", id: "12345678", changed: "{\"points\":15}", causationId: any string } }
    ]

scenario "by defaults to 1":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/counters/deaths", value: { value: 7, _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: IncrementField { collection: "counters", id: "deaths", field: "value" }
  predict success:
    response OK CommandResponse { answer: "8", value: 8 }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:counters", key: "deaths", json: { value: 8, _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "counters/deaths": any string } },
      IniWrite with IniWrite { section: "pending", key: "counters/deaths", json: { op: "increment", field: "value", by: 1, at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "counters/deaths" }
    ]
    firebase has ordered [
      increment with CloudIncrement { path: "users/uid-streamer/collections/counters/deaths", field: "value", by: 1 },
      update with CloudUpdate { path: "users/uid-streamer/collections/counters/deaths", fields: { _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_counters", value: { deaths: { value: 8 } } },
      Trigger with Trigger { name: "Firebase: Document Updated", pullData: { eventId: any uuid, eventType: "DocumentUpdated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "counters", id: "deaths", changed: "{\"value\":8}", causationId: any string } }
    ]

