{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-DOC-009",
  "schemas": {
    "Input": {
      "type": "object",
      "required": [
        "collection",
        "id",
        "field",
        "value"
      ],
      "properties": {
        "collection": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "CommandResponse": {
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "document": {
          "type": "object"
        },
        "value": {},
        "count": {
          "type": "integer"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "variables": {
          "type": "object"
        },
        "status": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "CommandError": {
      "type": "object",
      "required": [
        "code",
        "answer"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "answer": {
          "type": "string",
          "pattern": "^error: "
        }
      },
      "additionalProperties": false
    },
    "IniWrite": {
      "type": "object",
      "required": [
        "section",
        "key"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "json": {}
      },
      "additionalProperties": false
    },
    "IniDelete": {
      "type": "object",
      "required": [
        "section",
        "key"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CloudSet": {
      "type": "object",
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "CloudUpdate": {
      "type": "object",
      "required": [
        "path",
        "fields"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "CloudRemove": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CloudIncrement": {
      "type": "object",
      "required": [
        "path",
        "field",
        "by"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "by": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "CloudNode": {
      "type": "object",
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "AuthProvider": {
      "type": "object",
      "required": [
        "name",
        "enabled"
      ],
      "properties": {
        "name": {
          "enum": [
            "password"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "AuthProject": {
      "type": "object",
      "required": [
        "apiKey"
      ],
      "properties": {
        "apiKey": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AuthUser": {
      "type": "object",
      "required": [
        "email",
        "password",
        "uid"
      ],
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SetVariable": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^fb_[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "Trigger": {
      "type": "object",
      "required": [
        "name",
        "pullData"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^Firebase: "
        },
        "pullData": {
          "type": "object",
          "required": [
            "eventId",
            "eventType",
            "timestamp",
            "version",
            "source",
            "deviceId"
          ],
          "properties": {
            "eventId": {
              "type": "string"
            },
            "eventType": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "version": {
              "const": 1
            },
            "source": {
              "enum": [
                "local",
                "remote"
              ]
            },
            "deviceId": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
