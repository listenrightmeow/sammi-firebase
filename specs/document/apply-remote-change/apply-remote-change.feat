feat 1.0

# SPEC-DOC-008 — Apply Remote Change
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-DOC-008 "Apply Remote Change"
context SammiFirebase
aggregate Document
type command
status agreed

construct:
  handler at src/features/apply-remote-change/handler.ts
  touches src/features/apply-remote-change/**
  Issued by the RTDB listener for every child event under collections/. Mirror rule 2: apply when the remote _t is newer; rule 3: ignore an own echo (same _d, same _t) and emit nothing; rule 5: a null snapshot is a remote delete.
  Applies to the ini, the index and the variable; never writes to the cloud. Fires the Document event with source remote and the remote device id.

enforce:
  apply a newer remote snapshot and fire DocumentUpdated (or Created when unknown locally) with source remote
  apply a remote removal and fire DocumentDeleted with source remote
  keep the local document when the remote is not newer
  rejects OWN_ECHO when the snapshot carries this device id and the local timestamp
  rejects REMOTE_OLDER when the remote _t is not newer than the local _t
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name is not [a-z][a-z0-9_]{0,31}
  rejects BAD_ID when the id is not [A-Za-z0-9_-]{1,64}

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record IniDelete
  record CloudNode
  record AuthUser
  record SetVariable
  record Trigger

scenario "applies a newer snapshot from another machine (O3)":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275100000 } }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ApplyRemoteChange { collection: "hue", id: "settings", document: { ip: "192.168.1.99", scene_1: "3f2c", _t: 1793275199000, _d: "dev2" } }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:hue", key: "settings", json: { ip: "192.168.1.99", scene_1: "3f2c", _t: 1793275199000, _d: "dev2" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "hue/settings": any string } }
    ]
    firebase has []
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_hue", value: { settings: { ip: "192.168.1.99", scene_1: "3f2c" } } },
      Trigger with Trigger { name: "Firebase: Document Updated", pullData: { eventId: any uuid, eventType: "DocumentUpdated", timestamp: any timestamp, version: 1, source: "remote", deviceId: "dev2", collection: "hue", id: "settings", changed: "{\"ip\": \"192.168.1.99\"}" } }
    ]

scenario "a document unknown locally is created from the snapshot":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ApplyRemoteChange { collection: "viewers", id: "555", document: { name: "carol", points: 1, _t: 1793275199000, _d: "dev2" } }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:viewers", key: "555", json: { name: "carol", points: 1, _t: 1793275199000, _d: "dev2" } },
      IniWrite with IniWrite { section: "index", key: "collections", json: ["viewers"] },
      IniWrite with IniWrite { section: "index", key: "viewers", json: ["555"] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "viewers/555": any string } }
    ]
    firebase has []
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { "555": { name: "carol", points: 1 } } },
      Trigger with Trigger { name: "Firebase: Document Created", pullData: { eventId: any uuid, eventType: "DocumentCreated", timestamp: any timestamp, version: 1, source: "remote", deviceId: "dev2", collection: "viewers", id: "555", fields: "{\"name\": \"carol\", \"points\": 1}" } }
    ]

scenario "a null snapshot deletes locally":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/viewers/12345678", value: { name: "alice", points: 10, _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ApplyRemoteChange { collection: "viewers", id: "12345678", document: null }
  predict success:
    response OK CommandResponse { answer: "ok" }
    ini has ordered [
      IniDelete with IniDelete { section: "collection:viewers", key: "12345678" },
      IniWrite with IniWrite { section: "index", key: "viewers", json: [] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { } }
    ]
    firebase has []
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { } },
      Trigger with Trigger { name: "Firebase: Document Deleted", pullData: { eventId: any uuid, eventType: "DocumentDeleted", timestamp: any timestamp, version: 1, source: "remote", deviceId: any string, collection: "viewers", id: "12345678", previous: "{\"name\": \"alice\", \"points\": 10}" } }
    ]

scenario "rejects OWN_ECHO for this device's own write coming back (rule 3)":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev1" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ApplyRemoteChange { collection: "hue", id: "settings", document: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev1" } }
  predict rejection OWN_ECHO:
    response ERR CommandError { code: "OWN_ECHO", answer: "error: own echo" }
    ini has []
    firebase has []
    sammi has []

scenario "rejects REMOTE_OLDER when the local document is newer (rule 2)":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275199000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ApplyRemoteChange { collection: "hue", id: "settings", document: { ip: "1.1.1.1", scene_1: "3f2c", _t: 1793275110000, _d: "dev3" } }
  predict rejection REMOTE_OLDER:
    response ERR CommandError { code: "REMOTE_OLDER", answer: "error: remote older" }
    ini has []
    firebase has []
    sammi has []

scenario "rejects REMOTE_OLDER on an equal timestamp from another device (ties keep local)":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275199000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ApplyRemoteChange { collection: "hue", id: "settings", document: { ip: "1.1.1.1", scene_1: "3f2c", _t: 1793275199000, _d: "dev3" } }
  predict rejection REMOTE_OLDER:
    response ERR CommandError { code: "REMOTE_OLDER", answer: "error: remote older" }
    ini has []
    firebase has []
    sammi has []

