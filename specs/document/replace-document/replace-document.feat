feat 1.0

# SPEC-DOC-002 — Replace Document
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-DOC-002 "Replace Document"
context SammiFirebase
aggregate Document
type command
status agreed

construct:
  handler at src/features/replace-document/handler.ts
  touches src/features/replace-document/**
  Replace the whole document: fields not in the box are removed. Creates the document when missing (upsert), so a settings button needs no Exists check.
  Mirror rule 1 order; emits DocumentReplaced with the previous document when one existed, DocumentCreated otherwise.

enforce:
  remove fields absent from the box
  create the document when it does not exist and fire DocumentCreated
  fire DocumentReplaced with previous when it did
  a rejection writes nothing, publishes nothing and fires nothing
  rejects BAD_FIELD when the fields box is not a JSON object of strings and numbers
  rejects UNKNOWN_FIELD when the collection is strict and a field is not declared
  rejects TOO_LARGE when the document exceeds 8 KB or a field exceeds 4 KB
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name is not [a-z][a-z0-9_]{0,31}
  rejects BAD_ID when the id is not [A-Za-z0-9_-]{1,64}

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record IniDelete
  record CloudSet
  record CloudNode
  record AuthUser
  record SetVariable
  record Trigger

scenario "replaces the settings document and drops a field that is not in the box":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275100000 } }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ReplaceDocument { collection: "hue", id: "settings", fields: "{\"ip\": \"10.0.0.9\"}" }
  predict success:
    response OK CommandResponse { answer: "{\"ip\": \"10.0.0.9\"}", document: { ip: "10.0.0.9" } }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:hue", key: "settings", json: { ip: "10.0.0.9", _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "hue/settings": any string } },
      IniWrite with IniWrite { section: "pending", key: "hue/settings", json: { op: "replace", fields: { ip: "10.0.0.9" }, at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "hue/settings" }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/collections/hue/settings", value: { ip: "10.0.0.9", _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_hue", value: { settings: { ip: "10.0.0.9" } } },
      Trigger with Trigger { name: "Firebase: Document Replaced", pullData: { eventId: any uuid, eventType: "DocumentReplaced", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "hue", id: "settings", fields: "{\"ip\": \"10.0.0.9\"}", previous: "{\"ip\": \"192.168.1.20\", \"scene_1\": \"3f2c\"}", causationId: any string } }
    ]

scenario "creates the document when it does not exist and fires DocumentCreated":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275100000 } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ReplaceDocument { collection: "hue", id: "settings", fields: "{\"ip\": \"192.168.1.20\", \"scene_1\": \"3f2c\"}" }
  predict success:
    response OK CommandResponse { answer: "{\"ip\": \"192.168.1.20\", \"scene_1\": \"3f2c\"}", document: { ip: "192.168.1.20", scene_1: "3f2c" } }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:hue", key: "settings", json: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "collections", json: ["hue"] },
      IniWrite with IniWrite { section: "index", key: "hue", json: ["settings"] },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "hue/settings": any string } },
      IniWrite with IniWrite { section: "pending", key: "hue/settings", json: { op: "replace", fields: { ip: "192.168.1.20", scene_1: "3f2c" }, at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "hue/settings" }
    ]
    firebase has ordered [
      set with CloudSet { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_hue", value: { settings: { ip: "192.168.1.20", scene_1: "3f2c" } } },
      Trigger with Trigger { name: "Firebase: Document Created", pullData: { eventId: any uuid, eventType: "DocumentCreated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "hue", id: "settings", fields: "{\"ip\": \"192.168.1.20\", \"scene_1\": \"3f2c\"}", causationId: any string } }
    ]

scenario "rejects UNKNOWN_FIELD on a strict collection":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/meta/schema/hue", value: { fields: ["ip", "scene_1"], strict: true, two_way: true, _t: 1793275100000 } }, node with CloudNode { path: "users/uid-streamer/collections/hue/settings", value: { ip: "192.168.1.20", scene_1: "3f2c", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: ReplaceDocument { collection: "hue", id: "settings", fields: "{\"ip\": \"1.2.3.4\", \"colour\": \"red\"}" }
  predict rejection UNKNOWN_FIELD:
    response ERR CommandError { code: "UNKNOWN_FIELD", answer: "error: unknown field colour" }
    ini has []
    firebase has []
    sammi has []

