feat 1.0

# SPEC-DOC-006 — Delete Field
# Derived from model/contexts/sammi-firebase.moment, docs/10-domain-model.md and the ADRs in docs/adr/.
# Harness surfaces (SF-ADR-016): ini = firebase.ini writes · firebase = the user's Realtime Database · sammi = SAMMI variables and triggers.

spec SPEC-DOC-006 "Delete Field"
context SammiFirebase
aggregate Document
type command
status agreed

construct:
  handler at src/features/delete-field/handler.ts
  touches src/features/delete-field/**
  Remove one field from an existing document. Mirror rule 1 order; the cloud write is update() with the field set to null. Deleting the last field leaves an empty document (use Delete Document to remove it).

enforce:
  answer ok and fire DocumentUpdated with the removed field named
  a rejection writes nothing, publishes nothing and fires nothing
  rejects MISSING when the document or the field is not in the mirror
  rejects BAD_FIELD when the field name is reserved or invalid
  rejects NOT_CONNECTED when no connection is established
  rejects BAD_COLLECTION_NAME when the collection name is not [a-z][a-z0-9_]{0,31}
  rejects BAD_ID when the id is not [A-Za-z0-9_-]{1,64}

contract:
  input Input
  response CommandResponse
  error CommandError
  record IniWrite
  record IniDelete
  record CloudUpdate
  record CloudNode
  record AuthUser
  record SetVariable
  record Trigger

scenario "removes a field":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/viewers/12345678", value: { name: "alice", points: 10, tier: "gold", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DeleteField { collection: "viewers", id: "12345678", field: "tier" }
  predict success:
    response OK CommandResponse { answer: "ok", document: { name: "alice", points: 10 } }
    ini has ordered [
      IniWrite with IniWrite { section: "collection:viewers", key: "12345678", json: { name: "alice", points: 10, _t: 1793275200000, _d: "dev1" } },
      IniWrite with IniWrite { section: "index", key: "hashes", json: { "viewers/12345678": any string } },
      IniWrite with IniWrite { section: "pending", key: "viewers/12345678", json: { op: "delete_field", field: "tier", at: 1793275200000 } },
      IniDelete with IniDelete { section: "pending", key: "viewers/12345678" }
    ]
    firebase has ordered [
      update with CloudUpdate { path: "users/uid-streamer/collections/viewers/12345678", fields: { tier: null, _t: 1793275200000, _d: "dev1" } }
    ]
    sammi has ordered [
      SetVariable with SetVariable { name: "fb_viewers", value: { "12345678": { name: "alice", points: 10 } } },
      Trigger with Trigger { name: "Firebase: Document Updated", pullData: { eventId: any uuid, eventType: "DocumentUpdated", timestamp: any timestamp, version: 1, source: "local", deviceId: "dev1", collection: "viewers", id: "12345678", removed: "tier", causationId: any string } }
    ]

scenario "rejects MISSING when the field is absent":
  given:
    clock at "2026-10-29T12:00:00Z"
    seed ini [ IniWrite with IniWrite { section: "connection", key: "config", json: { apiKey: "AIzaSyProbeKey00000000000000000000000", authDomain: "sammi-probe.firebaseapp.com", projectId: "sammi-probe", appId: "1:000000000000:web:0000000000000000000000", databaseURL: "https://sammi-probe-default-rtdb.firebaseio.com" } }, IniWrite with IniWrite { section: "connection", key: "email", value: "streamer@example.com" }, IniWrite with IniWrite { section: "connection", key: "device_id", value: "dev1" } ]
    seed firebase [ user with AuthUser { email: "streamer@example.com", password: "correct-horse-battery", uid: "uid-streamer" }, node with CloudNode { path: "users/uid-streamer/collections/viewers/12345678", value: { name: "alice", _t: 1793275150000, _d: "dev2" } } ]
    execute Connect { email: "streamer@example.com", password: "correct-horse-battery" }
  when: DeleteField { collection: "viewers", id: "12345678", field: "tier" }
  predict rejection MISSING:
    response ERR CommandError { code: "MISSING", answer: "error: missing viewers/12345678 tier" }
    ini has []
    firebase has []
    sammi has []

