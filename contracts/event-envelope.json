        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "reason": {
          "$ref": "command-answer.json#/$defs/ErrorReason"
        }
      },
      "additionalProperties": false
    }
  }
}
