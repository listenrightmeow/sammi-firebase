        },
        "fields": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DocumentUpdated": {
      "type": "object",
      "required": [
        "eventId",
        "eventType",
        "timestamp",
        "version",
        "source",
        "collection",
        "id",
        "fields",
        "previous",
        "changed"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "DocumentUpdated"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "const": 1
        },
        "source": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "deviceId": {
          "type": "string"
        },
        "causationId": {
          "type": "string",
          "description": "the SAMMI button instance that issued the command when source is local; empty for remote"
        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "fields": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        },
        "changed": {
          "type": "string",
          "description": "JSON array of field names"
        }
      },
      "additionalProperties": false
    },
    "DocumentDeleted": {
      "type": "object",
      "required": [
        "eventId",
        "eventType",
        "timestamp",
        "version",
        "source",
        "collection",
        "id",
