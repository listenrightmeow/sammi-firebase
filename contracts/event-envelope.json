        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "const": 1
        },
        "source": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "deviceId": {
          "type": "string"
        },
        "causationId": {
          "type": "string",
          "description": "the SAMMI button instance that issued the command when source is local; empty for remote"
        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        }
      },
      "additionalProperties": false
    },
    "DocumentCreated": {
      "type": "object",
      "required": [
        "eventId",
        "eventType",
        "timestamp",
        "version",
        "source",
        "collection",
        "id",
        "fields"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "DocumentCreated"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "const": 1
        },
        "source": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "deviceId": {
          "type": "string"
        },
        "causationId": {
          "type": "string",
          "description": "the SAMMI button instance that issued the command when source is local; empty for remote"
        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "fields": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DocumentReplaced": {
      "type": "object",
      "required": [
        "eventId",
        "eventType",
        "timestamp",
        "version",
        "source",
        "collection",
        "id",
        "fields",
        "previous"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "DocumentReplaced"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "const": 1
        },
        "source": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "deviceId": {
          "type": "string"
        },
        "causationId": {
          "type": "string",
          "description": "the SAMMI button instance that issued the command when source is local; empty for remote"
